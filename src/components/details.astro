---
interface Props {
  items: { label: string; value: string; url?: string }[];
}

const { items } = Astro.props;
---

<div class="-mt-3 mb-3 grid grid-cols-2 grid-rows-2 gap-4">
  {
    items.map((item) => (
      <div class="flex flex-col gap-1">
        <p class="font-medium text-neutral-700">{item.label}</p>
        {item.url ? (
          <a href={item.url} target="_blank">
            {item.value}
          </a>
        ) : (
          <p>{item.value}</p>
        )}
      </div>
    ))
  }
</div>
