          <h3 class="text-lg font-medium group-hover:text-red-800">Tagged</h3>
          <p>E-commerce platform</p>
        </a>
      </div>
    </section>

    <section>
      <h2>Skills</h2>
      <div class="flex items-center gap-3">
        React, TypeScript, Next.js, PostgreSQL, and Python.
      </div>
    </section>
  </div>
</Layout>
